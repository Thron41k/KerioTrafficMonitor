<Window x:Class="KerioTrafficMonitor.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="Kerio Traffic Monitor"
        Width="980"
        Height="680"
        MinWidth="850"
        MinHeight="580">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Kerio Traffic Monitor   " FontSize="24" FontWeight="SemiBold" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Command="{Binding RefreshCommand}" Margin="0,0,8,0" Padding="16,7">Обновить</Button>
                <Button Command="{Binding SwitchNowCommand}" Padding="16,7">Сменить пользователя</Button>
                <Button
                    Click="Settings_Click"
                    Margin="10,0,8,0"
                    Padding="16,7">
                    Настройки
                </Button>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Padding="18" CornerRadius="8" BorderBrush="#D0D0D0" BorderThickness="1" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="0" Text="Текущий пользователь" FontSize="13" Foreground="Gray" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding CurrentUsername}" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,12" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding StatusText}" Foreground="Gray" />

                <TextBlock Grid.Column="1" Text="Квота" FontSize="13" Foreground="Gray" />
                <ProgressBar Grid.Row="1" Grid.Column="1" Height="24" Margin="0,8,20,8" Maximum="100" Value="{Binding QuotaUsedPercent}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding QuotaUsedPercent, StringFormat={}{0:F2}% использовано}" FontWeight="SemiBold" />

                <Grid Grid.Column="2" Grid.RowSpan="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Получено" Foreground="Gray" />
                    <TextBlock Grid.Row="1" Text="{Binding Received}" FontSize="17" Margin="0,2,0,8" />
                    <TextBlock Grid.Row="2" Text="Передано" Foreground="Gray" />
                    <TextBlock Grid.Row="3" Text="{Binding Sent}" FontSize="17" Margin="0,2,0,8" />
                    <TextBlock Grid.Row="4"
                               FontWeight="SemiBold">
                        <Run Text="Осталось: " />
                        <Run Text="{Binding QuotaRemainingPercent, Mode=OneWay, StringFormat={}{0:F2}%}" />
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="8" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Учетные записи" FontSize="17" FontWeight="SemiBold" Margin="4,0,0,10" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Command="{Binding MoveUpCommand}" Margin="0,0,6,0" Padding="13,6">↑</Button>
                    <Button Command="{Binding MoveDownCommand}" Margin="0,0,18,0" Padding="13,6">↓</Button>
                    <Button Command="{Binding AddUserCommand}" Margin="0,0,6,0" Padding="15,6">Добавить</Button>
                    <Button Command="{Binding DeleteUserCommand}" Padding="15,6">Удалить</Button>
                </StackPanel>

                <DataGrid ItemsSource="{Binding Users}"
                          SelectedItem="{Binding SelectedUser}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Priority}" Width="60" />
                        <DataGridTextColumn Header="Пользователь" Binding="{Binding Username}" Width="*" />
                        <DataGridTextColumn Header="Состояние" Binding="{Binding StatusText}" Width="180" />
                        <DataGridCheckBoxColumn Header="Активен" Binding="{Binding Model.IsEnabled}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="3" Margin="4,10,4,0">
            <TextBlock DockPanel.Dock="Right" Text="{Binding LastUpdated, StringFormat=Обновлено: {0}}" Foreground="Gray" />
            <TextBlock Text="{Binding ErrorText}" Foreground="Firebrick" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            IconSource="/Assets/KerioTrafficMonitor.ico"
            Visibility="Visible"
            ToolTipText="{Binding TrayToolTipText}"
            TrayMouseDoubleClick="TrayIcon_TrayMouseDoubleClick">

            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem
                        Header="Открыть"
                        Click="TrayOpen_Click"/>

                    <Separator/>
                    <MenuItem
                        Header="Настройки..."
                        Click="TraySettings_Click"/>
                    <Separator/>
                    <MenuItem
                        Header="Выйти"
                        Click="TrayExit_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>

        </tb:TaskbarIcon>
    </Grid>
</Window>
