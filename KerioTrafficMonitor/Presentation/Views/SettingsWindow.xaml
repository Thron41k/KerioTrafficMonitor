<Window
    x:Class="KerioTrafficMonitor.Presentation.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Настройки"
    Width="520"
    SizeToContent="Height"
    MinWidth="480"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    ShowInTaskbar="False">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock
                Text="Настройки подключения и мониторинга"
                FontSize="20"
                FontWeight="SemiBold"
                Margin="0,0,0,20"/>

            <TextBlock
                Text="Адрес сервера Kerio Control"
                FontWeight="SemiBold"/>

            <TextBox
                Text="{Binding ServerUrl,
                               UpdateSourceTrigger=PropertyChanged}"
                ToolTip="Например, http://192.168.17.254:4080/"/>

            <TextBlock
                Text="Интервал проверки, секунд"
                FontWeight="SemiBold"
                Margin="0,16,0,0"/>

            <TextBox
                Text="{Binding IntervalSeconds,
                               UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock
                Text="Порог использования квоты, %"
                FontWeight="SemiBold"
                Margin="0,16,0,0"/>

            <TextBox
                Text="{Binding ThresholdPercent,
                               UpdateSourceTrigger=PropertyChanged}"/>

            <CheckBox
                Content="Автоматически переключать пользователя при достижении порога"
                IsChecked="{Binding AutomaticSwitching}"/>

            <Border
                Background="#FFF1F0"
                BorderBrush="#E8A5A0"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8"
                Margin="0,16,0,0">

                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <TextBlock
                    Text="{Binding ErrorMessage}"
                    Foreground="#9C2720"
                    TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <ProgressBar
            Grid.Row="1"
            IsIndeterminate="True"
            Height="3"
            Margin="0,16,0,0"
            Visibility="{Binding IsBusy,
                Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,24,0,0">

            <Button
                Content="Отмена"
                Command="{Binding CancelCommand}"
                IsEnabled="{Binding IsBusy, Mode=OneWay}"
                MinWidth="100"
                Padding="12,7"
                Margin="0,0,8,0"/>

            <Button
                Content="Сохранить"
                Command="{Binding SaveCommand}"
                IsDefault="True"
                MinWidth="120"
                Padding="12,7"/>
        </StackPanel>
    </Grid>
</Window>